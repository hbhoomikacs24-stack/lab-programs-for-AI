        "\n",
        "# ====================================================\n",
        "# BACKWARD CHAINING WITH PROOF PATH HOOKS\n",
        "# ====================================================\n",
        "def fol_bc_ask(KB_rules, KB_facts, goals, theta, raw_edges):\n",
        "    if not goals:\n",
        "        yield theta, raw_edges\n",
        "        return\n",
        "\n",
        "    first = goals[0]\n",
        "    rest = goals[1:]\n",
        "\n",
        "    first_fact = substitute(theta, first)\n",
        "\n",
        "    # Check Ground Facts\n",
        "    for fact in KB_facts:\n",
        "        if fact.predicate == first_fact.predicate:\n",
        "            sub_theta = unify(first_fact.arguments, fact.arguments, theta)\n",
        "            if sub_theta is not None:\n",
        "                new_edges = raw_edges + [(\"FACT\", (fact.predicate, fact.arguments), first)]\n",
        "                yield from fol_bc_ask(KB_rules, KB_facts, rest, sub_theta, new_edges)\n",
