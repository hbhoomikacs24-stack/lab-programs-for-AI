        "            r_arg = new_theta[r_arg]\n",
        "        while f_arg in new_theta and new_theta[f_arg] != f_arg:\n",
        "            f_arg = new_theta[f_arg]\n",
        "\n",
        "        if r_arg == f_arg:\n",
