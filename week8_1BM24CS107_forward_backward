        "            return None\n",
        "    return new_theta\n",
        "\n",
        "def substitute(theta, element):\n",
        "    pred, args = element\n",
        "    new_args = []\n",
        "    for arg in args:\n",
        "        val = arg\n",
        "        while val in theta:\n",
