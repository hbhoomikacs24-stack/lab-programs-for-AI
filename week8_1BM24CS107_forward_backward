        "    print(\"\\n[Error]: Input processing failed.\")\n",
        "else:\n",
        "    goal_format = [(parsed_goal.predicate, parsed_goal.arguments)]\n",
        "\n",
        "    solutions = list(fol_bc_ask(rules_list, parsed_facts, goal_format, {}, []))\n",
        "\n",
        "    if solutions:\n",
        "        print(\"\\nFinal Engine Goal Outcome Check: PROVEN SUCCESSFUL\")\n",
        "        final_theta, successful_raw_edges = solutions[0]\n",
        "\n",
        "        # Reconstruct clean, fully substituted edge pairs matching textbook slide\n",
        "        final_edges = set()\n",
        "        node_heights = {}\n",
