        "import matplotlib.pyplot as plt\n",
        "import networkx as nx\n",
        "import re\n",
        "\n",
        "class Fact:\n",
        "    def __init__(self, predicate, arguments):\n",
        "        self.predicate = predicate\n",
        "        self.arguments = tuple(arg.strip() for arg in arguments)\n",
        "\n",
        "    def __repr__(self):\n",
        "        return f\"{self.predicate}({', '.join(self.arguments)})\"\n",
        "\n",
        "    def __eq__(self, other):\n",
        "        return isinstance(other, Fact) and self.predicate == other.predicate and self.arguments == other.arguments\n",
        "\n",
        "    def __hash__(self):\n",
        "        return hash((self.predicate, self.arguments))\n",
        "\n",
        "class Rule:\n",
        "    def __init__(self, antecedents, consequent):\n",
        "        self.antecedents = antecedents\n",
        "        self.consequent = consequent\n",
        "\n",
        "    def __repr__(self):\n",
        "        antecedents_str = \" ∧ \".join([f\"{p}({', '.join(a)})\" for p, a in self.antecedents])\n",
        "        return f\"{antecedents_str} ⇒ {self.consequent}({', '.join(self.consequent)})\"\n",
        "\n",
        "def unify(rule_args, fact_args, theta):\n",
        "    if theta is None: return None\n",
        "    if len(rule_args) != len(fact_args): return None\n",
        "    new_theta = theta.copy()\n",
        "    for r_arg, f_arg in zip(rule_args, fact_args):\n",
        "        if r_arg.islower():\n",
        "            if r_arg in new_theta:\n",
        "                if new_theta[r_arg] != f_arg: return None\n",
        "            else:\n",
        "                new_theta[r_arg] = f_arg\n",
        "        else:\n",
        "            if r_arg != f_arg: return None\n",
        "    return new_theta\n",
        "\n",
        "def substitute(theta, element):\n",
        "    pred, args = element\n",
        "    new_args = tuple(theta.get(arg, arg) for arg in args)\n",
        "    return Fact(pred, new_args)\n",
        "\n",
        "def clean_prefix(text):\n",
        "    text = text.strip()\n",
        "    # Remove colon headers like 'Rule 1:'\n",
        "    text = re.sub(r'^.*?:\\s*', '', text)\n",
        "    # BULLETPROOF FIX: Automatically strip out numbers like '3.', '5.', 'Rule 3' from the beginning of the text\n",
        "    text = re.sub(r'^(?:\\d+\\.|\\bRule\\s*\\d+\\.?)\\s*', '', text, flags=re.IGNORECASE)\n",
        "    return text.strip()\n",
        "\n",
        "def parse_fact_string(text):\n",
        "    text = clean_prefix(text)\n",
        "    if not text or \"(\" not in text or not text.endswith(\")\"): return None\n",
        "    idx = text.index(\"(\")\n",
        "    predicate = text[:idx].strip()\n",
        "    args_str = text[idx+1:-1]\n",
        "    arguments = tuple(arg.strip() for arg in args_str.split(\",\") if arg.strip())\n",
        "    return Fact(predicate, arguments)\n",
        "\n",
        "def parse_rule_string(text):\n",
        "    text = clean_prefix(text)\n",
        "    if \"->\" not in text and \"=>\" not in text: return None\n",
        "    normalized_text = text.replace(\"=>\", \"->\")\n",
        "    left, right = normalized_text.split(\"->\")\n",
        "    consequent_fact = parse_fact_string(right)\n",
        "    if not consequent_fact: return None\n",
        "\n",
        "    parts = re.split(r'\\s*(?:&|\\^|\\bAND\\b)\\s*', left)\n",
        "    antecedents = []\n",
        "    for part in parts:\n",
        "        f = parse_fact_string(part)\n",
        "        if f:\n",
        "            antecedents.append((f.predicate, f.arguments))\n",
        "    if antecedents:\n",
        "        return Rule(antecedents, (consequent_fact.predicate, consequent_fact.arguments))\n",
        "    return None\n",
        "\n",
        "def standardize_variables(rule, index):\n",
        "    var_map = {}\n",
        "    new_antecedents = []\n",
        "    for pred, args in rule.antecedents:\n",
        "        new_args = []\n",
        "        for arg in args:\n",
        "            if arg.islower():\n",
        "                if arg not in var_map:\n",
        "                    var_map[arg] = f\"{arg}_{index}\"\n",
        "                new_args.append(var_map[arg])\n",
        "            else:\n",
        "                new_args.append(arg)\n",
        "        new_antecedents.append((pred, tuple(new_args)))\n",
        "\n",
        "    conseq_pred, conseq_args = rule.consequent\n",
        "    new_conseq_args = []\n",
        "    for arg in conseq_args:\n",
        "        if arg.islower():\n",
        "            if arg not in var_map:\n",
        "                var_map[arg] = f\"{arg}_{index}\"\n",
        "            new_conseq_args.append(var_map[arg])\n",
        "        else:\n",
        "            new_conseq_args.append(arg)\n",
        "\n",
        "    return Rule(new_antecedents, (conseq_pred, tuple(new_conseq_args)))\n",
        "\n",
        "def fol_fc_ask_universal(KB_rules, KB_facts, alpha):\n",
        "    standardized_rules = [standardize_variables(r, i) for i, r in enumerate(KB_rules)]\n",
        "    known_facts = set(KB_facts)\n",
        "    edges = []\n",
        "    node_layers = {str(f): 0 for f in known_facts}\n",
        "\n",
        "    print(\"\\n--- [Inference Progress Log] ---\")\n",
        "    iteration = 1\n",
        "    goal_reached = False\n",
        "\n",
        "    while not goal_reached:\n",
        "        new_facts_this_iteration = set()\n",
        "        for rule in standardized_rules:\n",
        "            substitutions = [{'theta': {}, 'matched': []}]\n",
        "\n",
        "            for ant_pred, ant_args in rule.antecedents:\n",
        "                next_substitutions = []\n",
        "                for sub_dict in substitutions:\n",
        "                    current_theta = sub_dict['theta']\n",
        "                    current_matched = sub_dict['matched']\n",
        "                    for fact in known_facts:\n",
        "                        if fact.predicate == ant_pred:\n",
        "                            new_theta = unify(ant_args, fact.arguments, current_theta)\n",
        "                            if new_theta is not None:\n",
        "                                next_substitutions.append({\n",
        "                                    'theta': new_theta,\n",
        "                                    'matched': current_matched + [str(fact)]\n",
        "                                })\n",
        "                substitutions = next_substitutions\n",
        "\n",
        "            for sub_dict in substitutions:\n",
        "                theta = sub_dict['theta']\n",
        "                matched_facts = sub_dict['matched']\n",
        "                q_prime = substitute(theta, rule.consequent)\n",
        "\n",
        "                if q_prime not in known_facts and q_prime not in new_facts_this_iteration:\n",
        "                    new_facts_this_iteration.add(q_prime)\n",
        "                    print(f\"Iteration {iteration}: Derived -> {q_prime}\")\n",
        "\n",
        "                    max_parent_layer = 0\n",
        "                    for src in matched_facts:\n",
        "                        edges.append((src, str(q_prime)))\n",
        "                        max_parent_layer = max(max_parent_layer, node_layers.get(src, 0))\n",
        "                    node_layers[str(q_prime)] = max_parent_layer + 1\n",
        "\n",
        "                    if q_prime == alpha:\n",
        "                        goal_reached = True\n",
        "\n",
        "        if not new_facts_this_iteration: break\n",
        "        known_facts.update(new_facts_this_iteration)\n",
        "        iteration += 1\n",
        "\n",
        "    return edges, node_layers, goal_reached\n",
        "\n",
        "# ====================================================\n",
        "# LIVE CONSOLE ENVIRONMENT\n",
        "# ====================================================\n",
        "print(\"====================================================\")\n",
        "print(\"     UNIVERSAL FIRST-ORDER LOGIC INFERENCE ENGINE    \")\n",
        "print(\"====================================================\\n\")\n",
        "\n",
        "print(\"--- Step 1: Input Knowledge Base Facts ---\")\n",
        "facts_raw = input(\"Facts: \").strip()\n",
        "\n",
        "print(\"\\n--- Step 2: Input Rules Base Rules ---\")\n",
        "rules_list = []\n",
        "while True:\n",
        "    rule_raw = input(f\"Rule {len(rules_list)+1}: \").strip()\n",
        "    if rule_raw.upper() == \"DONE\": break\n",
        "    r_obj = parse_rule_string(rule_raw)\n",
        "    if r_obj:\n",
        "        rules_list.append(r_obj)\n",
        "    else:\n",
        "        print(\"Formatting error! Syntax template: A(x) & B(y) -> C(x)\")\n",
        "\n",
        "print(\"\\n--- Step 3: Input Target Goal Query ---\")\n",
        "goal_raw = input(\"Target Goal: \").strip()\n",
        "\n",
        "fact_items = re.findall(r'[A-Za-z0-9_]+\\([^)]+\\)', facts_raw)\n",
        "parsed_facts = [parse_fact_string(item) for item in fact_items if parse_fact_string(item)]\n",
        "parsed_goal = parse_fact_string(goal_raw)\n",
        "\n",
        "if not parsed_facts or not parsed_goal:\n",
        "    print(\"\\n[Error]: Input processing failed. Please verify syntax structures.\")\n",
        "else:\n",
        "    edges, layers, is_proven = fol_fc_ask_universal(rules_list, parsed_facts, parsed_goal)\n",
        "    print(f\"\\nFinal Engine Goal Outcome Check: {'PROVEN SUCCESSFUL' if is_proven else 'UNABLE TO PROVE'}\")\n",
        "\n",
        "    # ====================================================\n",
        "    # COMPACT GRAPH GENERATOR BLOCK\n",
        "    # ====================================================\n",
        "    if edges:\n",
        "        layers_dict = {}\n",
        "        for node, lvl in layers.items():\n",
        "            if lvl not in layers_dict: layers_dict[lvl] = []\n",
        "            layers_dict[lvl].append(node)\n",
        "\n",
        "        G = nx.DiGraph()\n",
        "        G.add_edges_from(edges)\n",
        "        pos = {}\n",
        "\n",
        "        for lvl, nodes in layers_dict.items():\n",
        "            count = len(nodes)\n",
        "            for idx, node in enumerate(nodes):\n",
        "                if node in G.nodes():\n",
        "                    x_coord = (idx - (count - 1) / 2.0) * 3.5 if count > 1 else 0.0\n",
        "                    y_coord = -lvl * 1.5\n",
        "                    pos[node] = (x_coord, y_coord)\n",
        "\n",
        "        color_map = []\n",
        "        for node in G.nodes():\n",
        "            if str(parsed_goal) in node: color_map.append('#ffcdd2')\n",
        "            elif layers.get(node, 0) == 0: color_map.append('#e3f2fd')\n",
        "            else: color_map.append('#e8f5e9')\n",
        "\n",
        "        plt.figure(figsize=(12, 7))\n",
        "        nx.draw_networkx_nodes(G, pos, node_size=5500, node_color=color_map, node_shape='s', edgecolors='black')\n",
        "        nx.draw_networkx_edges(G, pos, arrowstyle='->', arrowsize=20, edge_color='#1565c0', width=2)\n",
        "        nx.draw_networkx_labels(G, pos, font_size=8, font_weight='bold')\n",
        "        plt.title(f\"Dynamic Forward Chaining Inference Tree (Goal: {parsed_goal})\", fontsize=11, fontweight='bold', pad=15)\n",
        "        plt.axis('off')\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n"
