        "    text = re.sub(r'^(?:\\d+\\.|\\bRule\\s*\\d+\\.?)\\s*', '', text, flags=re.IGNORECASE)\n",
        "    return text.strip()\n",
        "\n",
        "def parse_fact_string(text):\n",
        "    text = clean_prefix(text)\n",
